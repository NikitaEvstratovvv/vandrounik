# Server
PORT=8787
DATABASE_PATH=./data/vandrounik.sqlite

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Email: leave RESEND_API_KEY empty in dev → code logged to console
# RESEND_API_KEY=re_xxx
# Dev sandbox: onboarding@resend.dev. Prod: verified domain sender.
EMAIL_FROM="Vandrounik <noreply@vandrounik.of.by>"
# Fixed code when Resend is off (dev). Leave unset in production.
DEV_LOGIN_CODE=0000

# Built frontend directory (Docker sets /app/dist)
# STATIC_DIR=../dist

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vandrounik.of.by

# Optional invite allowlist (comma-separated). Empty = allow all.
# ALLOWED_EMAILS=you@example.com

# Production (Railway): DATABASE_PATH=/data/vandrounik.sqlite + volume mount /data
# See docs/deploy.md
